#include "xparameters.h"
#include "xil_types.h"
#include "xil_io.h"
#include <iostream>

using namespace std;

int main()
{
    volatile u32* Timer_Ptr = (u32*) XPAR_TMRCTR_0_BASEADDR;

    const u32 tlr0 = 99999998; // 2s * 50MHz - 2
    const u32 tlr1 = 49999998; // 1s * 50MHz - 2

    cout << "==== COEN 317 Lab 3 Part 3: Fixed PWM Test ====" << endl;

    *(Timer_Ptr + 0) = 0x000;
    *(Timer_Ptr + 4) = 0x000;

    *(Timer_Ptr + 1) = tlr0;
    *(Timer_Ptr + 5) = tlr1;

    *(Timer_Ptr + 0) = 0x20;
    *(Timer_Ptr + 4) = 0x20;

    *(Timer_Ptr + 0) = 0x00;
    *(Timer_Ptr + 4) = 0x00;

    *(Timer_Ptr + 0) = 0xE6;
    *(Timer_Ptr + 4) = 0xE6;

    cout << "Fixed PWM running on LED." << endl;

    while (1)
    {
    }

    return 0;
}
