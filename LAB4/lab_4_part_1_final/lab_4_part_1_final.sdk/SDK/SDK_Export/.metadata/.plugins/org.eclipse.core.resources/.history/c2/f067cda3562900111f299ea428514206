#include <iostream>
using namespace std;

#include "xparameters.h"
#include "xstatus.h"
#include "xtmrctr.h"
#include "xscugic.h"
#include "xil_exception.h"

/* Global instances */
XScuGic InterruptController;
XTmrCtr TimerInstancePtr;
static XScuGic_Config *GicConfig;

/* Pointer to the base address of the AXI Timer for direct register access */
volatile unsigned int* timer_ptr = (volatile unsigned int*) XPAR_AXI_TIMER_0_BASEADDR;

/* Flag to communicate between the ISR and the main loop */
volatile bool interrupt_handled = false;

/* Timer callback (ISR)
   Must be kept as fast as possible.
*/
void Timer_InterruptHandler(void *CallBackRef, u8 TmrCtrNumber)
{
    // Read current status registers
    unsigned int tcsr0 = *(timer_ptr + 0);
    unsigned int tcsr1 = *(timer_ptr + 4);

    // 1. Stop both timers by clearing the Enable bit (Bit 7)
    *(timer_ptr + 0) = tcsr0 & ~(0x080);
    *(timer_ptr + 4) = tcsr1 & ~(0x080);

    // 2 & 3. Check which timer fired, print message, and clear its Interrupt bit (Bit 8)
    if (*(timer_ptr + 0) & 0x100)
    {
        cout << "Interrupt generated by Timer 0" << endl;
        *(timer_ptr + 0) = *(timer_ptr + 0) | 0x100;
    }

    if (*(timer_ptr + 4)  & 0x100)
    {
        cout << "Interrupt generated by Timer 1" << endl;
        *(timer_ptr + 4) = *(timer_ptr + 4) | 0x100;
    }

    // Tell the main loop to prompt the user for a restart
    interrupt_handled = true;
}

int SetUpInterruptSystem(XScuGic *XScuGicInstancePtr)
{
    Xil_ExceptionInit();
    Xil_ExceptionRegisterHandler(
        XIL_EXCEPTION_ID_INT,
        (Xil_ExceptionHandler)XScuGic_InterruptHandler,
        XScuGicInstancePtr
    );
    Xil_ExceptionEnable();
    return XST_SUCCESS;
}

int ScuGicInterrupt_Init(u16 DeviceId, XTmrCtr *TimerPtr)
{
    int Status;
    GicConfig = XScuGic_LookupConfig(DeviceId);
    if (GicConfig == NULL) return XST_FAILURE;

    Status = XScuGic_CfgInitialize(&InterruptController, GicConfig, GicConfig->CpuBaseAddress);
    if (Status != XST_SUCCESS) return XST_FAILURE;

    Status = SetUpInterruptSystem(&InterruptController);
    if (Status != XST_SUCCESS) return XST_FAILURE;

    Status = XScuGic_Connect(
        &InterruptController,
        XPAR_FABRIC_AXI_TIMER_0_INTERRUPT_INTR,
        (Xil_ExceptionHandler)XTmrCtr_InterruptHandler,
        (void *)TimerPtr
    );
    if (Status != XST_SUCCESS) return XST_FAILURE;

    XScuGic_Enable(&InterruptController, XPAR_FABRIC_AXI_TIMER_0_INTERRUPT_INTR);
    return XST_SUCCESS;
}

int main()
{
    int Status;
    char input;

    cout << "Application starts" << endl;

    /* Initialize timer hardware */
    Status = XTmrCtr_Initialize(&TimerInstancePtr, XPAR_AXI_TIMER_0_DEVICE_ID);
    if (Status != XST_SUCCESS)
    {
        cout << "TIMER INIT FAILED" << endl;
        return 1;
    }

    /* Register ISR */
    XTmrCtr_SetHandler(&TimerInstancePtr, Timer_InterruptHandler, &TimerInstancePtr);

    /* Initialize SCUGIC */
    Status = ScuGicInterrupt_Init(XPAR_PS7_SCUGIC_0_DEVICE_ID, &TimerInstancePtr);
    if (Status != XST_SUCCESS)
    {
        cout << "SCUGIC INIT FAILED" << endl;
        return 1;
    }

    /* Set reset values for BOTH timers.
       Timer 0 is set for ~1 second.
       Timer 1 is set for ~2 seconds so they don't constantly fire at the exact same time.
    */
    XTmrCtr_SetResetValue(&TimerInstancePtr, 0, 0xFD050F80);
    XTmrCtr_SetResetValue(&TimerInstancePtr, 1, 0xFA0A1F00);

    /* Enable interrupt mode and auto reload for both */
    XTmrCtr_SetOptions(&TimerInstancePtr, 0, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);
    XTmrCtr_SetOptions(&TimerInstancePtr, 1, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);

    // Initial Start Prompt
    cout << "Press any key to start both timers" << endl;
    cin >> input;
    cout << "You pressed " << input << endl;
    cout << "Starting both timers..." << endl;

    /* Start both timers using pointer math (0x0D4 = Enable, Interrupt, Auto-reload, Down-counter) */
    *(timer_ptr + 0) = 0x0D4;
    *(timer_ptr + 4) = 0x0D4;

    /* Main loop */
    while (1)
    {
        // 4. Prompt the user to restart after the ISR finishes handling an interrupt
        if (interrupt_handled)
        {
            cout << "Press any key to restart both timers" << endl;
            cin >> input;

            cout << "You pressed " << input << endl;
            cout << "Restarting both timers..." << endl;

            // Restart both timers
            *(timer_ptr + 0) = 0x0D4;
            *(timer_ptr + 4) = 0x0D4;

            // Reset the flag to wait for the next interrupt
            interrupt_handled = false;
        }
    }

    return 0;
}
