#include <iostream>
using namespace std;

#include "xparameters.h"
#include "xil_types.h"
#include "xtmrctr.h"
#include "xil_io.h"
#include "xil_exception.h"
#include "xscugic.h"
#include "xstatus.h"

/* Interrupt Controller instance */
XScuGic InterruptController;
static XScuGic_Config *GicConfig;

/* Timer instance */
XTmrCtr TimerInstancePtr;

/* Global second counter */
volatile int sec_count = 0;

/* Pointer to AXI Timer base address */
volatile u32* timer_ptr = (u32*) XPAR_AXI_TIMER_0_BASEADDR;

/*
   Register map for Timer 0:
   timer_ptr + 0  -> TCSR0
   timer_ptr + 1  -> TLR0
   timer_ptr + 2  -> TCR0

   Register map for Timer 1:
   timer_ptr + 4  -> TCSR1
   timer_ptr + 5  -> TLR1
   timer_ptr + 6  -> TCR1
*/

/* User interrupt callback */
void Timer_InterruptHandler(void)
{
    // Check if Timer 0 caused the interrupt by testing TINT = bit 8
    if ( (*(timer_ptr)) & (1 << 8) )
    {
        sec_count++;
        cout << "t = " << sec_count << " s" << endl;

        // Clear Timer 0 interrupt by writing 1 to bit 8
        *(timer_ptr) |= (1 << 8);
    }

    // Optional: if you ever enable Timer 1 too, this is the idea
    /*
    if ( (*(timer_ptr + 4)) & (1 << 8) )
    {
        cout << "Timer 1 interrupt occurred" << endl;
        *(timer_ptr + 4) |= (1 << 8);
    }
    */
}

int SetUpInterruptSystem(XScuGic *XScuGicInstancePtr)
{
    Xil_ExceptionInit();

    Xil_ExceptionRegisterHandler(
        XIL_EXCEPTION_ID_INT,
        (Xil_ExceptionHandler) XScuGic_InterruptHandler,
        XScuGicInstancePtr
    );

    Xil_ExceptionEnable();

    return XST_SUCCESS;
}

int ScuGicInterrupt_Init(u16 DeviceId, XTmrCtr *TimerInstancePtr)
{
    int Status;

    GicConfig = XScuGic_LookupConfig(DeviceId);
    if (GicConfig == NULL)
    {
        return XST_FAILURE;
    }

    Status = XScuGic_CfgInitialize(
        &InterruptController,
        GicConfig,
        GicConfig->CpuBaseAddress
    );
    if (Status != XST_SUCCESS)
    {
        return XST_FAILURE;
    }

    Status = SetUpInterruptSystem(&InterruptController);
    if (Status != XST_SUCCESS)
    {
        return XST_FAILURE;
    }

    // Connect AXI Timer interrupt to the timer driver ISR
    Status = XScuGic_Connect(
        &InterruptController,
        XPAR_FABRIC_AXI_TIMER_0_INTERRUPT_INTR,
        (Xil_ExceptionHandler) XTmrCtr_InterruptHandler,
        (void *) TimerInstancePtr
    );
    if (Status != XST_SUCCESS)
    {
        return XST_FAILURE;
    }

    XScuGic_Enable(&InterruptController, XPAR_FABRIC_AXI_TIMER_0_INTERRUPT_INTR);

    return XST_SUCCESS;
}

int main()
{
    int xStatus;

    cout << "Application starts" << endl;
    cout << "t = 0 s" << endl;

    // Step 1: Initialize AXI Timer
    xStatus = XTmrCtr_Initialize(&TimerInstancePtr, XPAR_AXI_TIMER_0_DEVICE_ID);
    if (xStatus != XST_SUCCESS)
    {
        cout << "TIMER INIT FAILED" << endl;
        if (xStatus == XST_DEVICE_IS_STARTED)
        {
            cout << "Timer has already started" << endl;
            cout << "Power cycle board and reprogram bitstream" << endl;
        }
        return 1;
    }

    // Step 2: Register user callback
    XTmrCtr_SetHandler(
        &TimerInstancePtr,
        (XTmrCtr_Handler) Timer_InterruptHandler,
        &TimerInstancePtr
    );

    // Step 3: Load reset value
    // 0xFFFFFF00 gives fast rollover for easy demonstration
    *(timer_ptr + 1) = 0xFFFFFF00;

    // Step 4: Configure Timer 0
    // 0x0F4 means:
    // bit 7 = enable interrupt
    // bit 6 = enable timer
    // bit 5 = load
    // bit 4 = auto reload
    // bit 2 = down/up mode depending on lab setup
    //
    // This is the same style used in the lab examples.
    *(timer_ptr) = 0x0F4;

    // Step 5: Initialize interrupt controller
    xStatus = ScuGicInterrupt_Init(XPAR_PS7_SCUGIC_0_DEVICE_ID, &TimerInstancePtr);
    if (xStatus != XST_SUCCESS)
    {
        cout << "SCUGIC INIT FAILED" << endl;
        return 1;
    }

    // Step 6: Start timer when user presses a key
    char input;
    cout << "Press any key to start the timer" << endl;
    cin >> input;

    cout << "You pressed " << input << endl;
    cout << "Timer started" << endl;

    // Deassert LOAD bit so timer begins counting
    *(timer_ptr) = 0x0D4;

    // Wait forever while interrupts occur
    while (1)
    {
    }

    return 0;
}
